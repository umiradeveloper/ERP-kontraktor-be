# Koneksi MySQL 8+
DATABASE_URL="mysql://root:password@localhost:3306/erp_kontraktor"

# Ganti dengan string acak panjang di production (simpan di secret manager)
JWT_ACCESS_SECRET="ganti-dengan-secret-acak-access"
JWT_REFRESH_SECRET="ganti-dengan-secret-acak-refresh"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS=7

PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Penyimpanan lampiran
UPLOAD_DIR="./uploads"

# Email notifikasi (opsional — kosongkan untuk menonaktifkan)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Kontrak ERP <no-reply@perusahaan.co.id>"

# Push notification aplikasi mobile (Firebase Cloud Messaging) — opsional.
# Isi path ke file service account dari Firebase Console → Project settings → Service accounts.
FIREBASE_SERVICE_ACCOUNT=""
